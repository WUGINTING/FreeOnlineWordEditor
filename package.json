{
  "name": "papyrus-docx",
  "version": "0.2.0",
  "description": "Open, edit and save Word (.docx) files in the browser without losing what the editor does not understand. Vue 3 + ProseMirror.",
  "keywords": [
    "docx",
    "word",
    "editor",
    "wysiwyg",
    "ooxml",
    "vue",
    "prosemirror"
  ],
  "license": "MIT",
  "homepage": "https://wuginting.github.io/FreeOnlineWordEditor/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WUGINTING/FreeOnlineWordEditor.git"
  },
  "bugs": "https://github.com/WUGINTING/FreeOnlineWordEditor/issues",
  "type": "module",
  "files": [
    "dist",
    "CLEAN_ROOM.md"
  ],
  "main": "./dist/papyrus-docx.js",
  "module": "./dist/papyrus-docx.js",
  "types": "./dist/types/index.d.ts",
  "unpkg": "./dist/papyrus-docx.standalone.iife.js",
  "jsdelivr": "./dist/papyrus-docx.standalone.iife.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/papyrus-docx.js"
    },
    "./standalone": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/papyrus-docx.standalone.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --mode standalone && vue-tsc -p tsconfig.build.json",
    "build:demo": "vite build --mode demo",
    "preview": "vite preview --mode demo",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "i18n": "node tests/papyrus/i18n/scan.mjs",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "prosemirror-commands": "^1.6.0",
    "prosemirror-dropcursor": "^1.8.1",
    "prosemirror-gapcursor": "^1.3.2",
    "prosemirror-history": "^1.4.1",
    "prosemirror-keymap": "^1.2.2",
    "prosemirror-model": "^1.24.0",
    "prosemirror-state": "^1.4.3",
    "prosemirror-tables": "^1.6.1",
    "prosemirror-transform": "^1.10.2",
    "prosemirror-view": "^1.37.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/compiler-sfc": "^3.5.13",
    "@vue/tsconfig": "^0.6.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.2.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "vue": "^3.5.13",
    "vue-tsc": "3.3.11"
  }
}
